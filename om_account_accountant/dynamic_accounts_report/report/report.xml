<odoo>
    <record id="action_report_pdf" model="ir.actions.report">
        <field name="name">Accounting Report</field><field name="model">dynamic.accounting.report</field>
        <field name="report_type">qweb-pdf</field><field name="report_name">dynamic_accounts_report.report_pdf</field>
    </record>
    <template id="report_pdf">
        <t t-call="web.html_container"><t t-foreach="docs" t-as="doc"><t t-call="web.external_layout">
            <div class="page"><h2 t-out="report['title']"/><p><t t-out="report['company']"/> · <t t-out="report['currency']"/> · <t t-out="report['date_from']"/> – <t t-out="report['date_to']"/></p>
                <table class="table table-sm" style="font-size:10px"><thead><tr><th>Description</th><th class="text-end" t-foreach="report['columns']" t-as="column" t-out="column"/></tr></thead><tbody>
                    <t t-foreach="report['rows']" t-as="row"><t t-foreach="[row] + row['children']" t-as="item"><tr><td t-out="item['label']"/><td class="text-end" t-foreach="item['values']" t-as="amount"><span t-out="amount" t-options="{'widget':'float', 'precision':report['digits']}"/></td></tr></t></t>
                </tbody><tfoot t-if="report['totals']"><tr><th>Total</th><th class="text-end" t-foreach="report['totals']" t-as="amount"><span t-out="amount" t-options="{'widget':'float', 'precision':report['digits']}"/></th></tr></tfoot></table>
            </div>
        </t></t></t>
    </template>
</odoo>
