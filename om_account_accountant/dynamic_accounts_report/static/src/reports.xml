<templates xml:space="preserve"><t t-name="dynamic_accounts_report.Reports"><div class="o_action o_dynamic_reports d-flex flex-column h-100">
<ControlPanel><t t-set-slot="control-panel-buttons"><button class="btn btn-primary" t-att-disabled="this.state.busy" t-on-click="() => this.exportReport('export_pdf')">PDF</button><button class="btn btn-secondary" t-att-disabled="this.state.busy" t-on-click="() => this.exportReport('export_xlsx')">XLSX</button></t>
<t t-set-slot="control-panel-actions"><button class="btn btn-secondary d-md-none" t-att-aria-expanded="this.state.mobileFilters" aria-controls="o_dynamic_filter_controls" t-on-click="() => this.toggleMobileFilters()">Filters <span class="ms-2 text-muted" t-out="this.dateLabel"/></button><div id="o_dynamic_filter_controls" class="o_dynamic_toolbar d-flex flex-wrap gap-1 align-items-center" t-att-class="{o_dynamic_toolbar_open: this.state.mobileFilters}">
<Dropdown state="this.filterMenus.date" menuClass="'o_dynamic_filter_menu'"><button class="btn btn-secondary o_dynamic_filter_toggle"><i class="fa fa-calendar-o me-1"/><t t-out="this.dateLabel"/><span class="o_dynamic_dropdown_chevron" aria-hidden="true"/></button><t t-set-slot="content"><div class="o_dynamic_filter_heading">Reporting period</div><div t-if="!this.isAging" class="o_dynamic_preset_list"><button t-foreach="this.periodPresets" t-as="period" t-key="period[0]" class="dropdown-item" t-on-click="() => this.selectPreset(period[0])" t-out="period[1]"/></div><div class="p-3 border-top"><label t-if="!this.isAging">From<input type="date" class="form-control" t-att-value="this.state.options.date_from" t-on-input="(ev) => this.setOption('date_from', ev.target.value)"/></label><label><t t-if="this.isAging">As of</t><t t-else="">To</t><input type="date" class="form-control" t-att-value="this.state.options.date_to" t-on-input="(ev) => this.setOption('date_to', ev.target.value)"/></label></div><div class="o_dynamic_filter_footer"><button class="btn btn-primary btn-sm" t-on-click="() => this.applyFilters()" t-att-disabled="this.state.busy">Apply</button></div></t></Dropdown><t t-if="this.canCompare"><Dropdown state="this.filterMenus.comparison" menuClass="'o_dynamic_filter_menu'"><button class="btn btn-secondary o_dynamic_filter_toggle"><t t-out="this.comparisonLabel"/><span class="o_dynamic_dropdown_chevron" aria-hidden="true"/></button><t t-set-slot="content"><div class="o_dynamic_filter_heading">Comparison</div><button class="dropdown-item" t-on-click="() => this.selectOption('comparison_count', 0)">No comparison</button><div class="p-3 border-top"><label>Compare with<select class="form-select" t-att-value="this.state.options.comparison_type" t-on-change="(ev) => this.setOption('comparison_type', ev.target.value)"><option value="month">Previous months</option><option value="quarter">Previous quarters</option><option value="year">Previous years</option></select></label><label>Number of periods<input class="form-control" type="number" min="1" max="12" t-att-value="this.state.options.comparison_count || 1" t-on-input="(ev) => this.setOption('comparison_count', ev.target.value)"/></label></div><div class="o_dynamic_filter_footer"><button class="btn btn-primary btn-sm" t-on-click="() => this.applyComparison()" t-att-disabled="this.state.busy">Apply</button></div></t></Dropdown></t>
<Dropdown state="this.filterMenus.journals" menuClass="'o_dynamic_filter_menu'"><button class="btn btn-secondary o_dynamic_filter_toggle">Journals<span t-if="this.state.options.journal_ids.length" class="badge text-bg-primary ms-1" t-out="this.state.options.journal_ids.length"/><span class="o_dynamic_dropdown_chevron" aria-hidden="true"/></button><t t-set-slot="content"><div class="o_dynamic_filter_heading">Journals<button class="btn btn-link btn-sm p-0" t-on-click="() => this.setOption('journal_ids', [])">Clear</button></div><div class="p-3"><MultiRecordSelector resModel="'account.journal'" resIds="this.state.options.journal_ids" domain="this.companyDomain" update="(ids) => this.setOption('journal_ids', ids)" placeholder="'Search journals…'"/></div><div class="o_dynamic_filter_footer"><button class="btn btn-primary btn-sm" t-on-click="() => this.applyFilters()" t-att-disabled="this.state.busy">Apply</button></div></t></Dropdown>
<Dropdown state="this.filterMenus.accounts" menuClass="'o_dynamic_filter_menu'"><button class="btn btn-secondary o_dynamic_filter_toggle">Accounts<span t-if="this.state.options.account_ids.length" class="badge text-bg-primary ms-1" t-out="this.state.options.account_ids.length"/><span class="o_dynamic_dropdown_chevron" aria-hidden="true"/></button><t t-set-slot="content"><div class="o_dynamic_filter_heading">Accounts<button class="btn btn-link btn-sm p-0" t-on-click="() => this.setOption('account_ids', [])">Clear</button></div><div class="p-3"><MultiRecordSelector resModel="'account.account'" resIds="this.state.options.account_ids" domain="this.accountDomain" update="(ids) => this.setOption('account_ids', ids)" placeholder="'Search accounts…'"/></div><div class="o_dynamic_filter_footer"><button class="btn btn-primary btn-sm" t-on-click="() => this.applyFilters()" t-att-disabled="this.state.busy">Apply</button></div></t></Dropdown>
<Dropdown state="this.filterMenus.partners" menuClass="'o_dynamic_filter_menu'"><button class="btn btn-secondary o_dynamic_filter_toggle">Partners<span t-if="this.state.options.partner_ids.length" class="badge text-bg-primary ms-1" t-out="this.state.options.partner_ids.length"/><span class="o_dynamic_dropdown_chevron" aria-hidden="true"/></button><t t-set-slot="content"><div class="o_dynamic_filter_heading">Partners<button class="btn btn-link btn-sm p-0" t-on-click="() => this.setOption('partner_ids', [])">Clear</button></div><div class="p-3"><MultiRecordSelector resModel="'res.partner'" resIds="this.state.options.partner_ids"  update="(ids) => this.setOption('partner_ids', ids)" placeholder="'Search partners…'"/></div><div class="o_dynamic_filter_footer"><button class="btn btn-primary btn-sm" t-on-click="() => this.applyFilters()" t-att-disabled="this.state.busy">Apply</button></div></t></Dropdown>
<Dropdown state="this.filterMenus.analytic" menuClass="'o_dynamic_filter_menu'"><button class="btn btn-secondary o_dynamic_filter_toggle">Analytic<span t-if="this.state.options.analytic_ids.length" class="badge text-bg-primary ms-1" t-out="this.state.options.analytic_ids.length"/><span class="o_dynamic_dropdown_chevron" aria-hidden="true"/></button><t t-set-slot="content"><div class="o_dynamic_filter_heading">Analytic<button class="btn btn-link btn-sm p-0" t-on-click="() => this.setOption('analytic_ids', [])">Clear</button></div><div class="p-3"><MultiRecordSelector resModel="'account.analytic.account'" resIds="this.state.options.analytic_ids"  update="(ids) => this.setOption('analytic_ids', ids)" placeholder="'Search analytic…'"/></div><div class="o_dynamic_filter_footer"><button class="btn btn-primary btn-sm" t-on-click="() => this.applyFilters()" t-att-disabled="this.state.busy">Apply</button></div></t></Dropdown>
<Dropdown state="this.filterMenus.options" menuClass="'o_dynamic_filter_menu'"><button class="btn btn-secondary o_dynamic_filter_toggle"><i class="fa fa-sliders me-1"/><t t-out="this.state.options.include_draft ? 'Draft &amp; posted entries' : 'Posted entries'"/><span class="o_dynamic_dropdown_chevron" aria-hidden="true"/></button><t t-set-slot="content"><div class="o_dynamic_filter_heading">Report options</div><button class="dropdown-item" t-on-click="() => this.selectOption('include_draft', !this.state.options.include_draft)"><span class="o_dynamic_option_check" aria-hidden="true" t-out="this.state.options.include_draft ? '✓' : ''"/>Include draft entries</button><button t-if="this.isTrial" class="dropdown-item" t-on-click="() => this.toggleHierarchy()"><span class="o_dynamic_option_check" aria-hidden="true" t-out="this.state.options.hierarchy ? '✓' : ''"/>Account hierarchy</button><div t-if="!this.isAging &amp;&amp; !['profit_loss','balance_sheet','tax'].includes(this.state.options.report)" class="p-3 border-top"><label>Accounts to display<select class="form-select" t-att-value="this.state.options.display_account" t-on-change="(ev) => this.setOption('display_account', ev.target.value)"><option value="all">All accounts</option><option value="movement">With movements</option><option value="not_zero">With a balance</option></select></label><label t-if="!this.isTrial">Sort entries<select class="form-select" t-att-value="this.state.options.sortby" t-on-change="(ev) => this.setOption('sortby', ev.target.value)"><option value="date">Date</option><option value="journal_partner">Journal and partner</option></select></label><label t-if="!this.isTrial" class="form-check"><input type="checkbox" class="form-check-input" t-att-checked="this.state.options.initial_balance" t-on-change="(ev) => this.setOption('initial_balance', ev.target.checked)"/>Show opening balance in details</label></div><button class="dropdown-item border-top" t-on-click="() => this.openAdvanced()">Advanced report options…</button><div class="o_dynamic_filter_footer"><button class="btn btn-primary btn-sm" t-on-click="() => this.applyFilters()" t-att-disabled="this.state.busy">Apply</button></div></t></Dropdown><t t-if="this.state.companies.length &gt; 1"><Dropdown state="this.filterMenus.company" menuClass="'o_dynamic_filter_menu'"><button class="btn btn-secondary o_dynamic_filter_toggle">Company<span class="o_dynamic_dropdown_chevron" aria-hidden="true"/></button><t t-set-slot="content"><div class="p-3"><label>Company<select class="form-select" t-on-change="(ev) => this.changeCompany(ev)" t-att-value="this.state.options.company_id"><option t-foreach="this.state.companies" t-as="company" t-key="company.id" t-att-value="company.id" t-out="company.name"/></select></label></div></t></Dropdown></t>
</div></t></ControlPanel>
<div class="o_dynamic_report_tools"><div class="o_dynamic_search"><i class="fa fa-search text-muted"/><input type="search" class="form-control" aria-label="Search report" placeholder="Search accounts…" t-att-value="this.state.search" t-on-input="(ev) => this.setSearch(ev.target.value)"/><button t-if="this.state.search" class="btn btn-link p-0" aria-label="Clear search" t-on-click="() => this.setSearch('')">×</button></div><div class="d-flex align-items-center gap-2"><button t-if="this.isTrial" class="btn btn-sm btn-light" t-att-aria-pressed="this.state.options.hierarchy" t-on-click="() => this.toggleHierarchy()"><i class="fa fa-sitemap me-1"/><t t-out="this.state.options.hierarchy ? 'Hierarchy' : 'Flat list'"/></button><button class="btn btn-sm btn-light" t-on-click="() => this.unfold()" title="Expand every account group">Expand all</button><button class="btn btn-sm btn-light" t-on-click="() => this.fold()" title="Collapse every account group">Collapse all</button><button class="btn btn-sm btn-light" title="Refresh report" aria-label="Refresh report" t-att-disabled="this.state.busy" t-on-click="() => this.load()"><span aria-hidden="true">↻</span></button></div></div>
<div class="o_content flex-grow-1 overflow-auto"><div t-if="this.state.error" class="alert alert-danger m-3" role="alert" t-out="this.state.error"/><t t-if="this.state.report">            <div class="o_dynamic_table_container"><table class="table table-borderless table-hover o_dynamic_table">
                <thead>
<tr class="o_dynamic_company_heading"><th><t t-out="this.state.report.company"/><span class="ms-2" t-out="this.state.report.currency"/></th><th t-att-colspan="this.tableColumns.length"/></tr>
<tr t-if="this.isTrial" class="o_dynamic_column_groups"><th rowspan="2" class="align-bottom">Account</th><th colspan="2">Initial Balance</th><th colspan="2"><t t-out="this.state.report.date_from"/> – <t t-out="this.state.report.date_to"/></th><th colspan="2">End Balance</th><th t-foreach="this.state.report.columns.slice(4)" t-as="period" t-key="period_index" t-out="period"/></tr>
<tr><th t-if="!this.isTrial">Description</th><th class="text-end" t-foreach="this.tableColumns" t-as="column" t-key="column_index" t-out="column"/></tr></thead>
                <tbody>
                    <t t-foreach="this.rows" t-as="row" t-key="row.key">
                        <tr t-att-class="{o_dynamic_summary: true, o_dynamic_group: row.treeChildren, o_dynamic_child: row.tree &amp;&amp; row.level &gt; 0}"><td t-att-style="'padding-left:' + (12 + row.level * 20) + 'px'">
                            <button t-if="row.children.length || row.treeChildren" class="btn btn-sm btn-link p-0 me-2" t-on-click="() => this.toggle(row)" t-att-aria-expanded="row.open || !!this.state.expanded[row.key]" t-att-aria-label="(row.open || this.state.expanded[row.key] ? 'Collapse ' : 'Expand ') + row.label"><span class="o_dynamic_disclosure" t-att-class="{o_dynamic_disclosure_open: row.open || this.state.expanded[row.key]}" aria-hidden="true"/></button>
                            <a t-if="row.domain.length" href="#" t-on-click.prevent="() => this.openItems(row)" t-out="row.label"/><span t-else="" t-out="row.label"/>
                        </td><td class="text-end text-nowrap" t-foreach="row.values" t-as="value" t-key="value_index" t-out="this.format(value)"/></tr>
                        <t t-if="this.state.expanded[row.key]">
                            <tr t-foreach="row.children" t-as="child" t-key="child.key" class="o_dynamic_detail"><td class="ps-4">
                                <a t-if="child.move_id" href="#" t-on-click.prevent="() => this.openMove(child.move_id)" t-out="child.label"/><span t-else="" t-out="child.label"/>
                                <small class="d-block text-muted" t-if="child.foreign_currency"><t t-out="this.format(child.foreign_amount)"/> <t t-out="child.foreign_currency"/></small>
                                <small class="d-block text-muted" t-foreach="child.analytic || []" t-as="analytic" t-key="analytic_index" t-out="analytic"/>
                            </td><td class="text-end text-nowrap" t-foreach="child.values" t-as="value" t-key="value_index" t-out="this.format(value)"/></tr>
                        </t>
                    </t>
                    <tr t-if="!this.rows.length"><td t-att-colspan="this.tableColumns.length + 1" class="text-center text-muted p-4">No entries match these filters.</td></tr>
                </tbody><tfoot t-if="this.tableTotals.length"><tr><th>Total</th><th class="text-end" t-foreach="this.tableTotals" t-as="amount" t-key="amount_index" t-out="this.format(amount)"/></tr></tfoot>
            </table></div>
</t></div></div></t></templates>