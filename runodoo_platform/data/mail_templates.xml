<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- one template for every platform notice: subject and text come from the context (oh_subject / oh_body) -->
    <record id="mail_template_platform_notice" model="mail.template">
        <field name="name">Run Odoo: platform notice</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="subject">{{ ctx.get('oh_subject') or 'Your Run Odoo account' }}</field>
        <field name="email_from">{{ (user.company_id.email_formatted or user.email_formatted) }}</field>
        <field name="partner_to">{{ object.id }}</field>
        <field name="auto_delete" eval="True"/>
        <field name="body_html" type="html">
<div style="margin: 0; padding: 0; font-size: 14px;">
    <p>Hello <t t-out="object.name or ''"/>,</p>
    <p><t t-out="ctx.get('oh_body') or ''"/></p>
    <p style="margin: 24px 0;">
        <a t-att-href="(object.get_base_url() or '') + '/my/platform'"
           style="background-color: #006bff; padding: 10px 18px; text-decoration: none; color: #fff; border-radius: 6px;">Your hosting account</a>
    </p>
    <p>— Run Odoo</p>
</div>
        </field>
    </record>
</odoo>
