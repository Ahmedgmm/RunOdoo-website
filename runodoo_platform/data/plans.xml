<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Starting plans (USD). noupdate: created once, then edit them in Website → Hosting plans — upgrades keep your
         changes. Prices are final (no tax line added): set taxes on the products if VAT must be charged.
         Workers ≥ projects (each production needs one); dev / staging always run 1 worker. -->
    <record id="plan_starter" model="product.template">
        <field name="name">Starter</field>
        <field name="type">service</field>
        <field name="sale_ok" eval="True"/>
        <field name="purchase_ok" eval="False"/>
        <field name="sequence">10</field>
        <field name="list_price">29</field>
        <field name="taxes_id" eval="[(5, 0, 0)]"/>
        <field name="oh_plan">starter</field>
        <field name="oh_period">month</field>
        <field name="oh_currency_id" ref="base.USD"/>
        <field name="oh_workers">1</field>
        <field name="oh_storage_gb">10</field>
        <field name="oh_production" eval="True"/>
        <field name="oh_projects">1</field>
        <field name="oh_staging_envs">1</field>
        <field name="oh_collaborators">2</field>
        <field name="oh_backup_days">7</field>
        <field name="oh_highlight" eval="False"/>
        <field name="oh_features">Daily backups
Free SSL
E-mail support</field>
    </record>
