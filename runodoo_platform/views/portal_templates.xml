<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- the big box on /my/home -->
    <template id="portal_my_home_platform" name="Run Odoo: control panel box" inherit_id="portal.portal_my_home">
        <xpath expr="//div[@id='oe_structure_portal_my_home_1']" position="after">
            <t t-set="oh_partner" t-value="request.env.user.partner_id.commercial_partner_id.sudo()"/>
            <div class="ro-acct o_runodoo_box">
                <div class="ro-acct-hero">
                    <div class="ro-acct-hero-top">
                        <div>
                            <span class="ro-acct-eyebrow">Run Odoo hosting</span>
                            <h1 t-if="oh_partner.oh_account_id">Your control panel</h1>
                            <h1 t-else="">Put your Odoo online</h1>
                            <p t-if="oh_partner.oh_account_id">Signed in with GitHub as
                                <b>@<t t-out="oh_partner.oh_login"/></b><t t-if="oh_partner.oh_plan"> · <t t-out="oh_partner.oh_plan.capitalize()"/> plan</t>.</p>
                            <p t-else="">Choose a plan or start a free trial: every Git branch becomes its own Odoo environment.</p>
                        </div>
                        <div class="ro-acct-hero-actions">
                            <form t-if="oh_partner.oh_account_id and oh_partner.oh_status == 'active'"
                                  action="/my/platform/open" method="post" target="_blank">
                                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                <button type="submit" class="ro-acct-btn ro-acct-btn-blue">Open control panel →</button>
                            </form>
                            <a href="/my/platform" class="ro-acct-btn ro-acct-btn-white">
                                <t t-if="oh_partner.oh_account_id">Plan &amp; usage</t>
                                <t t-else="">Get started →</t>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </xpath>
    </template>

    <template id="portal_breadcrumbs_platform" inherit_id="portal.portal_breadcrumbs">
        <xpath expr="//ol[hasclass('o_portal_submenu')]" position="inside">
            <li t-if="page_name == 'runodoo_platform'" class="breadcrumb-item active">Hosting</li>
        </xpath>
    </template>

    <template id="portal_my_platform" name="Run Odoo: my hosting">
        <t t-call="portal.portal_layout">
            <t t-set="o_portal_fullwidth_alert" t-value="False"/>
            <t t-set="paid" t-value="bool(subscription) and not unpaid"/>
            <t t-set="state" t-value="partner.oh_state or partner.oh_status"/>
            <t t-set="month_plans" t-value="plans.filtered(lambda p: p.oh_period != 'year')"/>
            <t t-set="year_plans" t-value="plans.filtered(lambda p: p.oh_period == 'year')"/>
            <div class="ro-acct o_runodoo_platform">
                <div t-if="error" class="ro-acct-alert ro-acct-alert-bad" role="alert" t-out="error"/>
                <div t-if="notice" class="ro-acct-alert ro-acct-alert-ok" role="status" t-out="notice"/>

                <!-- ===== status + the one next action ===== -->
                <section class="ro-acct-hero">
                    <div class="ro-acct-hero-top">
                        <div>
                            <span class="ro-acct-eyebrow">Your hosting</span>
                            <t t-if="connected">
                                <h1 t-if="can_open">Your hosting is ready</h1>
                                <h1 t-elif="state == 'suspended'">Your account is paused</h1>
                                <h1 t-else="">Your account is <t t-out="state"/></h1>
                                <p t-if="can_open">Open the control panel to add projects, deploy branches and manage backups.</p>
                                <p t-elif="unpaid">Pay invoice <b t-out="unpaid[0].name"/> and your environments start again.</p>
                                <p t-else="">Contact us if you think this is a mistake.</p>
                                <div class="ro-acct-meta">
                                    <span class="ro-acct-chip">
                                        <i t-attf-class="ro-acct-dot #{'' if state == 'active' else ('ro-acct-dot-bad' if state in ('suspended', 'deleting') else 'ro-acct-dot-warn')}"/>
                                        <t t-out="(state or '').capitalize()"/>
                                    </span>
                                    <span class="ro-acct-chip">GitHub @<t t-out="partner.oh_login"/></span>
                                    <span t-if="partner.oh_plan" class="ro-acct-chip"><t t-out="partner.oh_plan.capitalize()"/> plan</span>
                                    <span t-if="partner.oh_expires_at" class="ro-acct-chip">
                                        <t t-if="partner.oh_plan == 'trial'">Trial ends</t><t t-else="">Paid until</t>
                                        <t t-out="partner.oh_expires_at[:10]"/>
                                    </span>
                                </div>
                            </t>
                            <t t-elif="unpaid">
                                <h1>Waiting for payment</h1>
                                <p>Your <b t-out="subscription.product_id.name"/> plan starts as soon as invoice
                                    <b t-out="unpaid[0].name"/> is paid. You'll then get a button here to connect GitHub.</p>
                            </t>
                            <t t-elif="live_invite">
                                <h1>Connect your GitHub account</h1>
                                <p><t t-if="subscription">Your <b t-out="subscription.product_id.name"/> plan is active. </t>
                                    Sign in with GitHub once to create your control panel account. After that, this page
                                    opens it with one click.</p>
                            </t>
                            <t t-elif="subscription">
                                <h1>Preparing your account</h1>
                                <p>Your plan is paid. Your GitHub sign-up link is being prepared: reload this page in a minute.</p>
                            </t>
                            <t t-else="">
                                <h1>Put your Odoo online</h1>
                                <p>Choose a plan below, or try everything free for <t t-out="trial_days"/> days, no card needed.</p>
                            </t>
                        </div>
                        <div class="ro-acct-hero-actions">
                            <form t-if="can_open" action="/my/platform/open" method="post" target="_blank">
                                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                <button type="submit" class="ro-acct-btn ro-acct-btn-blue">Open control panel →</button>
                            </form>
                            <a t-elif="unpaid" class="ro-acct-btn ro-acct-btn-white" t-att-href="unpaid[0].get_portal_url()">View invoice</a>
                            <form t-elif="not connected and live_invite" action="/my/platform/connect" method="post">
                                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                <button type="submit" class="ro-acct-btn ro-acct-btn-blue">Connect GitHub →</button>
                            </form>
                            <!-- a chosen plan waits for its invoice: no free trial around it -->
                            <form t-elif="not connected and not subscription" action="/my/platform/trial" method="post">
                                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                <button type="submit" class="ro-acct-btn ro-acct-btn-white">Start free trial →</button>
                            </form>
                        </div>
                    </div>

                    <!-- where the customer is, until the control panel opens -->
                    <ol t-if="not connected" class="ro-acct-steps">
                        <li t-attf-class="#{'is-done' if subscription or live_invite else 'is-now'}">
                            <b>Choose a plan</b>or start a free trial</li>
                        <li t-attf-class="#{'is-done' if paid or live_invite else ('is-now' if unpaid else '')}">
                            <b>Payment</b>invoice cleared</li>
                        <li t-attf-class="#{'is-now' if live_invite else ''}">
                            <b>Connect GitHub</b>one-time sign-in</li>
                        <li><b>Control panel</b>deploy your Odoo</li>
                    </ol>
                </section>

                <!-- ===== an invoice to pay ===== -->
                <div t-if="unpaid and connected" class="ro-acct-bill">
                    <div class="ro-acct-bill-icon">🧾</div>
                    <div class="ro-acct-bill-body">
                        <b>Invoice <t t-out="unpaid[0].name"/></b>
                        <div class="ro-acct-muted">Due <t t-out="unpaid[0].invoice_date_due or unpaid[0].invoice_date"/></div>
                    </div>
                    <div class="ro-acct-bill-amount" t-out="unpaid[0].amount_residual"
                         t-options="{'widget': 'monetary', 'display_currency': unpaid[0].currency_id}"/>
                    <a class="ro-acct-btn ro-acct-btn-ink ro-acct-btn-sm" t-att-href="unpaid[0].get_portal_url()">View invoice</a>
                </div>

                <!-- ===== usage + current plan ===== -->
                <div t-if="connected or subscription" class="ro-acct-grid">
                    <div t-if="not connected" class="ro-acct-card">
                        <h3>What happens next</h3>
                        <ol class="ro-acct-next">
                            <li t-if="unpaid">We confirm your payment, then this page shows the next button.</li>
                            <li>Click <b>Connect GitHub</b> here and sign in (a free GitHub account is enough).</li>
                            <li>In the control panel, click <b>New project</b> and pick the GitHub repository with your
                                modules.</li>
                            <li>Your Odoo is built and goes online. Every change you upload to GitHub deploys by itself.</li>
                        </ol>
                    </div>
                    <div t-if="connected" class="ro-acct-card">
                        <h3>Usage</h3>
                        <div class="ro-acct-usage">
                            <t t-foreach="[('projects', 'max_projects', 'Projects'), ('envs', 'max_envs', 'Environments'),
                                           ('running_envs', 'max_running_envs', 'Running now'),
                                           ('collaborators', 'max_collaborators', 'Collaborators'),
                                           ('disk_gb', 'disk_gb', 'Storage (GB)')]" t-as="row">
                                <t t-set="used" t-value="usage.get(row[0]) or 0"/>
                                <t t-set="cap" t-value="limits.get(row[1])"/>
                                <t t-set="pct" t-value="min(100, round(100.0 * used / cap)) if cap and cap is not True else 0"/>
                                <div>
                                    <div class="ro-acct-meter-label"><t t-out="row[2]"/>
                                        <span><t t-out="used"/> of <t t-out="cap if cap not in (None, False) else '—'"/></span></div>
                                    <div class="ro-acct-meter"><i t-att-class="'is-full' if pct &gt;= 100 else None" t-attf-style="width: #{pct}%"/></div>
                                </div>
                            </t>
                        </div>
                        <div t-if="partner.oh_over_limit" class="ro-acct-over">
                            Over your plan: <t t-out="', '.join(partner.oh_over_limit)"/>
                        </div>
                    </div>
                    <div class="ro-acct-card">
                        <div class="ro-acct-card-head">
                            <h3>Your plan</h3>
                            <a href="/my/invoices">Invoices →</a>
                        </div>
                        <dl t-if="subscription" class="ro-acct-facts">
                            <div><dt>Plan</dt><dd t-out="subscription.product_id.name"/></div>
                            <div><dt>Billing</dt><dd t-out="'Yearly' if subscription.period == 'year' else 'Monthly'"/></div>
                            <div><dt>Price</dt><dd>
                                <t t-out="subscription.product_id.lst_price" t-options="{'widget': 'monetary', 'display_currency': subscription.product_id.oh_currency_id or subscription.product_id.currency_id}"/>
                                <t t-if="subscription.discount"> (−<t t-out="'%g' % subscription.discount"/>%)</t></dd></div>
                            <div t-if="subscription.coupon_id"><dt>Coupon</dt><dd t-out="subscription.coupon_id.name"/></div>
                            <div><dt>Paid until</dt><dd t-out="subscription.paid_until or 'Not paid yet'"/></div>
                            <div t-if="subscription.next_invoice_date and paid"><dt>Next invoice</dt><dd t-out="subscription.next_invoice_date"/></div>
                        </dl>
                        <p t-else="" class="ro-acct-muted mb-0">You're on the free trial. Choose a plan below to keep your
                            environments when it ends.</p>
                        <p t-if="subscription" class="ro-acct-muted mt-3 mb-0">To change plan, <a href="/contactus">contact us</a>:
                            changes apply from the next period.</p>
                    </div>
                </div>

                <!-- ===== plans (until one is chosen) ===== -->
                <section t-if="not subscription and plans" class="ro-acct-plans-wrap">
                    <input t-if="year_plans" type="radio" name="ro_period" id="ro_per_m" class="ro-acct-per" checked="checked"/>
                    <input t-if="year_plans" type="radio" name="ro_period" id="ro_per_y" class="ro-acct-per"/>
                    <div class="ro-acct-plans-head">
                        <div>
                            <h2>Choose your plan</h2>
                            <div class="ro-acct-muted">Prices in US dollars. You pay by invoice; nothing is charged automatically.</div>
                        </div>
                        <div t-if="year_plans" class="ro-acct-switch" role="radiogroup" aria-label="Billing period">
                            <label for="ro_per_m">Monthly</label>
                            <label for="ro_per_y">Yearly <small>2 months free</small></label>
                        </div>
                    </div>
                    <form id="oh_subscribe" class="ro-acct-coupon" action="/my/platform/subscribe" method="post">
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                        <label for="oh_coupon">Have a coupon?</label>
                        <input type="text" id="oh_coupon" name="coupon" autocomplete="off" maxlength="64" placeholder="Enter your code"/>
                        <span>It's applied to the plan you choose.</span>
                    </form>
                    <div class="ro-acct-plans">
                        <article t-foreach="month_plans + year_plans" t-as="plan"
                                 t-attf-class="ro-acct-plan #{'is-year' if plan.oh_period == 'year' else 'is-month'} #{'is-hl' if plan.oh_highlight else ''}">
                            <span t-if="plan.oh_highlight" class="ro-acct-plan-badge">Most popular</span>
                            <h3 t-out="plan.name.replace(' (yearly)', '')"/>
                            <p class="ro-acct-price">
                                <s t-if="discount" t-out="plan.list_price" t-options="{'widget': 'monetary', 'display_currency': plan.oh_currency_id or plan.currency_id}"/>
                                <b t-out="round(plan.list_price * (100 - discount) / 100, 2)" t-options="{'widget': 'monetary', 'display_currency': plan.oh_currency_id or plan.currency_id}"/>
                                <span t-out="'/ year' if plan.oh_period == 'year' else '/ month'"/>
                            </p>
                            <ul>
                                <li t-foreach="plan.product_tmpl_id._oh_lines()" t-as="line" t-out="line"/>
                            </ul>
                            <button type="submit" form="oh_subscribe" name="product_id" t-att-value="plan.id"
                                    t-attf-class="ro-acct-btn #{'ro-acct-btn-blue' if plan.oh_highlight else 'ro-acct-btn-ink'}">
                                Choose <t t-out="plan.name.replace(' (yearly)', '')"/></button>
                        </article>
                    </div>
                    <p class="ro-acct-plans-note">Need more projects or workers? <a href="/contactus">Talk to us</a> about a custom plan.</p>
                </section>
            </div>
        </t>
    </template>

    <!-- one-time login link: posted straight to the panel, token in the body only -->
    <template id="portal_platform_handoff" name="Run Odoo: opening the control panel">
        &lt;!DOCTYPE html&gt;
        <html>
            <head>
                <meta charset="utf-8"/>
                <meta name="referrer" content="no-referrer"/>
                <meta name="robots" content="noindex"/>
                <title>Opening the control panel…</title>
                <style>body{font:16px system-ui,sans-serif;max-width:32rem;margin:20vh auto;padding:0 1rem;color:#0b3558}</style>
            </head>
            <body>
                <form id="oh_sso" method="post" t-att-action="url">
                    <input type="hidden" name="token" t-att-value="token"/>
                    <p>Opening the control panel…</p>
                    <noscript><button type="submit">Continue</button></noscript>
                </form>
                <script>document.getElementById('oh_sso').submit();</script>
            </body>
        </html>
    </template>
</odoo>
