<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_runodoo" model="ir.ui.view">
        <field name="name">product.template.form.runodoo_platform</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Hosting plan" name="runodoo_plan">
                    <group>
                        <group string="Plan">
                            <field name="oh_plan" placeholder="e.g. starter"/>
                            <field name="oh_period" invisible="not oh_plan"/>
                            <field name="oh_currency_id" invisible="not oh_plan"/>
                            <field name="oh_highlight" invisible="not oh_plan"/>
                        </group>
                        <group string="What the customer gets" invisible="not oh_plan">
                            <field name="oh_workers"/>
                            <field name="oh_storage_gb"/>
                            <field name="oh_production"/>
                            <field name="oh_projects"/>
                            <field name="oh_staging_envs"/>
                            <field name="oh_collaborators"/>
                            <field name="oh_backup_days"/>
                        </group>
                    </group>
                    <group invisible="not oh_plan">
                        <field name="oh_features" placeholder="Daily backups&#10;Free SSL&#10;E-mail support"/>
                        <field name="oh_limits" placeholder='{"build_minutes_per_day": 120}'/>
                    </group>
                    <div class="text-muted small" invisible="not oh_plan">
                        Memory and CPU are never shown to customers: the platform sizes each environment from its workers.
                        The plan appears on /pricing and /my/platform while "Can be sold" is on.
                    </div>
                </page>
            </xpath>
        </field>
    </record>

    <record id="product_template_list_runodoo_plans" model="ir.ui.view">
        <field name="name">product.template.list.runodoo_plans</field>
        <field name="model">product.template</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <list string="Hosting plans">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="oh_plan"/>
                <field name="oh_period"/>
                <field name="list_price"/>
                <field name="oh_workers"/>
                <field name="oh_storage_gb"/>
                <field name="oh_projects"/>
                <field name="oh_staging_envs"/>
                <field name="oh_highlight"/>
                <field name="sale_ok"/>
            </list>
        </field>
    </record>

    <record id="action_runodoo_plans" model="ir.actions.act_window">
        <field name="name">Hosting plans</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('oh_plan', '!=', False)]</field>
        <field name="view_id" ref="product_template_list_runodoo_plans"/>
        <field name="context">{'default_type': 'service', 'default_oh_plan': 'starter'}</field>
    </record>
</odoo>
