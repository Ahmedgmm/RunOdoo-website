<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Brand assets of the default website: favicon (browser tab) and logo (default header on non-home pages).
         A function, not a <record>: base.default_website is noupdate, so a record would be skipped on upgrade. -->
    <function model="website" name="_runodoo_apply_branding"/>
</odoo>
