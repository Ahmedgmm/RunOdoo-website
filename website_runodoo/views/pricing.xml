<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Pricing: hand-written (not generated by port_to_odoo.py). The cards come from the hosting-plan products
         (runodoo_platform, Website → Hosting plans): add or edit a plan in Odoo and /pricing + the homepage follow.
         Plans sell workers and storage; memory / CPU are never shown. -->

    <template id="ro_plan_cards" name="Runodoo: plan cards">
        <!-- signed-in customers go to their platform page, everyone else signs up first -->
        <t t-set="ro_cta_href" t-value="'/my/platform' if not request.env.user._is_public() else '/web/signup?redirect=%2Fmy%2Fplatform'"/>
        <t t-set="ro_plans" t-value="website._runodoo_pricing()"/>
        <t t-set="ro_trial_days" t-value="website._runodoo_trial_days()"/>
        <p t-if="ro_plans and ro_plans[0]['pct']" class="ro-offer">
            <b t-out="ro_plans[0]['label']"/> — <t t-out="'%g' % ro_plans[0]['pct']"/>% off every plan, for as long as you stay subscribed.
        </p>
        <div class="ro-plans">
            <article class="ro-plan ro-plan-trial">
                <h3>Free trial</h3>
                <p class="ro-plan-price"><b>0</b><span><t t-out="ro_trial_days"/> days</span></p>
                <ul>
                    <li>Every feature, to try your Odoo</li>
                    <li>1 worker, staging environments</li>
                    <li>No payment card needed</li>
                </ul>
                <a class="ro-btn ro-btn-line" t-att-href="ro_cta_href">Start free trial</a>
            </article>
            <article t-foreach="ro_plans" t-as="card" t-attf-class="ro-plan #{'ro-plan-hl' if card['highlight'] else ''}">
                <span t-if="card['highlight']" class="ro-plan-badge">Most popular</span>
                <h3 t-out="card['name']"/>
                <p t-if="card['pct']" class="ro-plan-was">
                    <s t-out="card['main'].list_price" t-options="{'widget': 'monetary', 'display_currency': card['currency']}"/>
                    <em><t t-out="'%g' % card['pct']"/>% off</em>
                </p>
                <p class="ro-plan-price">
                    <b t-out="card['price']" t-options="{'widget': 'monetary', 'display_currency': card['currency']}"/>
                    <span t-out="'/ year' if card['main'].oh_period == 'year' else '/ month'"/>
                </p>
                <p t-if="card['year_price']" class="ro-plan-alt">
                    or <t t-out="card['year_price']" t-options="{'widget': 'monetary', 'display_currency': card['currency']}"/> / year
                    <s t-if="card['pct']" t-out="card['year'].list_price" t-options="{'widget': 'monetary', 'display_currency': card['currency']}"/>
                </p>
                <p t-if="card['main'].description_sale" class="ro-plan-desc" t-out="card['main'].description_sale"/>
                <ul>
                    <li t-foreach="card['lines']" t-as="line" t-out="line"/>
                </ul>
                <a t-attf-class="ro-btn #{'ro-btn-blue' if card['highlight'] else 'ro-btn-ink'}" t-att-href="ro_cta_href">Choose <t t-out="card['name']"/></a>
            </article>
        </div>
        <p t-if="not ro_plans" class="ro-plans-soon">Paid plans are coming soon — start with the free trial.</p>
        <p t-if="ro_plans" class="ro-plans-soon">Prices in US dollars. Need more projects or workers? <a href="/contactus">Talk to us</a> about a custom plan.</p>
    </template>

    <template id="pricing" name="Pricing">
        <t t-call="website.layout">
            <t t-set="additional_title">Pricing</t>
            <div id="wrap" class="ro-home ro-doc">
                <t t-call="website_runodoo.ro_nav"/>
                <main class="ro-wrap ro-doc-main">
                    <div class="ro-doc-head">
                        <span class="ro-eyebrow">Pricing</span>
                        <h1>Simple plans for your Odoo</h1>
                        <p>Pick the workers and storage you need. Backups, updates, SSL and e-mail are included in every plan.</p>
                    </div>
                    <t t-call="website_runodoo.ro_plan_cards"/>
                    <div class="ro-plan-notes">
                        <div class="ro-card ro-card-soft">
                            <h2>What is a worker?</h2>
                            <p>A worker is an Odoo process that answers your users. More workers mean more people can work at the same time without waiting. Most small teams start with 1–2; add more any time.</p>
                        </div>
                        <div class="ro-card ro-card-soft">
                            <h2>What counts as storage?</h2>
                            <p>Your database, attachments and code across all your environments. Backups are kept on top of it.</p>
                        </div>
                        <div class="ro-card ro-card-soft">
                            <h2>Changing or cancelling</h2>
                            <p>Upgrade or cancel any time. See our <a href="/returns-and-refunds">returns &amp; refunds policy</a>.</p>
                        </div>
                    </div>
                </main>
                <t t-call="website_runodoo.ro_foot"/>
            </div>
        </t>
    </template>

    <!-- homepage: a pricing section before the FAQ, a Pricing link in the nav, and the FAQ answer points at it.
         Inherits the generated homepage, so regenerating homepage.xml keeps these. -->
    <template id="homepage_pricing" inherit_id="website_runodoo.homepage" name="Runodoo Home: pricing">
        <xpath expr="//nav[hasclass('ro-nav-menu')]/a[@href='#ro-faq']" position="before">
            <a href="#ro-pricing">Pricing</a>
        </xpath>
        <xpath expr="//section[@id='ro-faq']" position="before">
            <section id="ro-pricing" class="ro-sec ro-sec-white ro-pricing-sec">
                <div class="ro-wrap">
                    <div class="ro-head">
                        <span class="ro-eyebrow">Pricing</span>
                        <h2>Pay for the workers you need</h2>
                        <p class="ro-sub">Backups, updates, SSL and e-mail on every plan.</p>
                    </div>
                    <t t-call="website_runodoo.ro_plan_cards"/>
                </div>
            </section>
        </xpath>
        <xpath expr="//section[@id='ro-faq']//details[1]/p" position="replace">
            <p>The first <t t-out="website._runodoo_trial_days()"/> days are free. After that, plans are paid monthly or yearly by the workers and storage you need — <a href="/pricing">see pricing</a>.</p>
        </xpath>
    </template>

    <!-- nav of the hand-written pages -->
    <template id="ro_nav_pricing" inherit_id="website_runodoo.ro_nav" name="Runodoo: page nav pricing">
        <xpath expr="//nav[hasclass('ro-nav-menu')]/a[@href='/#ro-faq']" position="before">
            <a href="/pricing">Pricing</a>
        </xpath>
    </template>
    <template id="ro_foot_pricing" inherit_id="website_runodoo.ro_foot" name="Runodoo: footer pricing">
        <xpath expr="//a[@href='/#ro-how']" position="before">
            <a href="/pricing">Pricing</a>
        </xpath>
    </template>
</odoo>
